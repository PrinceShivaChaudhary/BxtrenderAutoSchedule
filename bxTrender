def update_all_weekly_with_today(daily_folder, weekly_folder):
    """
    For every ticker CSV in daily folder, 
    take its last row and add to matching ticker CSV in weekly folder.
    """
    
    daily_path = Path(daily_folder)
    weekly_path = Path(weekly_folder)
    
    # Get all ticker files from daily folder
    daily_files = list(daily_path.glob("*.csv"))
    
    for daily_file in daily_files:
        #daily_file = daily_files[0]
        ticker = daily_file.stem  # filename without .csv
        weekly_file = weekly_path / f"{ticker}.csv"
        
        # Skip if weekly file doesn't exist
        if not weekly_file.exists():
            print(f" Missing weekly file: {weekly_file}")
            continue
            
        print(f" Updating {ticker}...")
        
        # Read daily and weekly
        daily_df = pd.read_csv(daily_file)
        weekly_df = pd.read_csv(weekly_file)
        
        # Convert Date to datetime
        daily_df["Date"] = pd.to_datetime(daily_df["Date"])
        weekly_df["Date"] = pd.to_datetime(weekly_df["Date"])
        
        # Get today's row from daily
        today_row = daily_df.sort_values("Date").iloc[[-1]]
        today_date = today_row["Date"].iloc[0]
        
        # Remove existing today row from weekly
        weekly_df = weekly_df[weekly_df["Date"] != today_date]
        
        # Add today's row
        weekly_df = pd.concat([weekly_df, today_row], ignore_index=True)
        
        # Sort by date
        #weekly_df = weekly_df.sort_values("Date").reset_index(drop=True)
        
        # Save updated weekly file
        weekly_df.to_csv(weekly_file, index=False)
        print(f" {ticker} updated with today: {today_date.strftime('%Y-%m-%d')}")
    
    print(" All weekly files updated!")

def create_monthly_from_daily(daily_folder, monthly_folder):
    """
    For every CSV in daily folder, create monthly data (month-end prices)
    and save as ticker_monthly.csv in monthly folder.
    """
    
    daily_path = Path(daily_folder)
    monthly_path = Path(monthly_folder)
    monthly_path.mkdir(exist_ok=True)  # Create folder if missing
    
    # Get all daily CSV files
    daily_files = list(daily_path.glob("*.csv"))
    
    for daily_file in daily_files:
        ticker = daily_file.stem  # "AAPL" from "AAPL.csv"
        monthly_file = monthly_path / f"{ticker}.csv"
        
        print(f"Processing {ticker}...")
        
        # Read daily data
        df = pd.read_csv(daily_file)
        df["Date"] = pd.to_datetime(df["Date"])
        
        # Group by year-month, take LAST trading day of each month
        df["year_month"] = df["Date"].dt.to_period("M")
        monthly_df = df.sort_values("Date").groupby("year_month").tail(1)
        
        # Clean up and save
        monthly_df = monthly_df[["Date", "Close"]].reset_index(drop=True)
        monthly_df.to_csv(monthly_file, index=False)
        
        print(f" {ticker}: {len(monthly_df)} months → {monthly_file}")


def create_15day_from_daily(daily_folder, fifteen_day_folder):
    """
    For every CSV in daily folder, create 15-day candle data (every 15 trading days)
    and save as ticker_15day.csv in fifteen_day folder.
    """
    
    daily_path = Path(daily_folder)
    fifteen_day_path = Path(fifteen_day_folder)
    fifteen_day_path.mkdir(exist_ok=True)  # Create folder if missing
    
    # Get all daily CSV files
    daily_files = list(daily_path.glob("*.csv"))
    
    for daily_file in daily_files:
        ticker = daily_file.stem  # "AAPL" from "AAPL.csv"
        fifteen_file = fifteen_day_path / f"{ticker}.csv"
        
        print(f" Processing {ticker}...")
        
        # Read daily data
        df = pd.read_csv(daily_file)
        df["Date"] = pd.to_datetime(df["Date"])
        
        # Create 15-day groups: every 15 trading days
        df["row_id"] = range(len(df))
        df["period_15"] = df["row_id"] // 15
        
        # Take LAST trading day of each 15-day period
        fifteen_df = df.sort_values("Date").groupby("period_15").tail(1)
        
        # Clean up and save (Date + Close)
        fifteen_df = fifteen_df[["Date", "Close"]].reset_index(drop=True)
        fifteen_df.to_csv(fifteen_file, index=False)
        
        print(f" {ticker}: {len(fifteen_df)} 15-day periods → {fifteen_file}")



def market_bias_cerebr(
    df: pd.DataFrame,
    ha_len: int = 100,
    ha_len2: int = 100,
    osc_len: int = 7,
) -> pd.DataFrame:
    """
    Market Bias (CEREBR) – Python implementation of the indicator logic
    (no higher‑timeframe / no-repaint machinery, only same-timeframe math).

    Parameters
    ----------
    df : DataFrame
        Must contain columns: 'Open','High','Low','Close'.
    ha_len : int
        Period for the first EMA smoothing of OHLC.
    ha_len2 : int
        Period for the second EMA smoothing (Heikin Ashi smoothing).
    osc_len : int
        Period for EMA smoothing of the oscillator.

    Returns
    -------
    DataFrame
        Input df with added columns:
        o_smooth, c_smooth, h_smooth, l_smooth
        ha_close, ha_open, ha_high, ha_low
        o2, c2, h2, l2
        ha_avg
        osc_bias, osc_smooth
        sigcolor (as RGBA hex strings)
        candle_color (bull/bear color for smoothed HA candles)
    """

    out = df.copy()

    # --- 1) First EMA smoothing of OHLC (Pine: o,c,h,l) ---
    o = out["Open"].ewm(span=ha_len, adjust=False).mean()
    c = out["Close"].ewm(span=ha_len, adjust=False).mean()
    h = out["High"].ewm(span=ha_len, adjust=False).mean()
    l = out["Low"].ewm(span=ha_len, adjust=False).mean()

    out["o_smooth"] = o
    out["c_smooth"] = c
    out["h_smooth"] = h
    out["l_smooth"] = l

    # --- 2) Heikin Ashi OHLC (Pine: haclose, haopen, hahigh, halow) ---
    haclose = (o + h + l + c) / 4.0

    # xhaopen in Pine = (o + c)/2, then haopen uses previous xhaopen and haclose
    xhaopen = (o + c) / 2.0

    haopen = np.full(len(out), np.nan)
    # Pine: haopen = na(xhaopen[1]) ? (o + c)/2 : (xhaopen[1] + haclose[1]) / 2
    # For bar 0, treat "na(xhaopen[1])" as true => use (o + c)/2 at index 0
    haopen[0] = xhaopen.iloc[0]
    for i in range(1, len(out)):
        # previous xhaopen and haclose
        haopen[i] = (xhaopen.iloc[i - 1] + haclose.iloc[i - 1]) / 2.0

    haopen = pd.Series(haopen, index=out.index)

    hahigh = pd.concat(
        [
            h,
            haopen,
            haclose
        ],
        axis=1
    ).max(axis=1)
    halow = pd.concat(
        [
            l,
            haopen,
            haclose
        ],
        axis=1
    ).min(axis=1)

    out["ha_close"] = haclose
    out["ha_open"] = haopen
    out["ha_high"] = hahigh
    out["ha_low"] = halow

    # --- 3) Second EMA smoothing on HA candles (Pine: o2, c2, h2, l2) ---
    o2 = haopen.ewm(span=ha_len2, adjust=False).mean()
    c2 = haclose.ewm(span=ha_len2, adjust=False).mean()
    h2 = hahigh.ewm(span=ha_len2, adjust=False).mean()
    l2 = halow.ewm(span=ha_len2, adjust=False).mean()

    out["o2"] = o2
    out["c2"] = c2
    out["h2"] = h2
    out["l2"] = l2

    # --- 4) Bias average line (Pine: ha_avg) ---
    ha_avg = (h2 + l2) / 2.0
    out["ha_avg"] = ha_avg

    # --- 5) Oscillator (Pine: osc_bias, osc_smooth, sigcolor) ---
    osc_bias = 100.0 * (c2 - o2)
    osc_smooth = osc_bias.ewm(span=osc_len, adjust=False).mean()

    out["osc_bias"] = osc_bias
    out["osc_smooth"] = osc_smooth

    # Colors comparable to Pine defaults
    col_bull = "#00FF00"  # lime
    col_bear = "#FF0000"  # red

    # Helper to emulate color.new(color, alpha) with RGBA hex
    # alpha in Pine is 0–100 => 0–255 here
    def color_new(base_hex: str, alpha_pine: int) -> str:
        base_hex = base_hex.lstrip("#")
        r = int(base_hex[0:2], 16)
        g = int(base_hex[2:4], 16)
        b = int(base_hex[4:6], 16)
        a = int(round(255 * (1 - alpha_pine / 100.0)))
        return f"#{r:02X}{g:02X}{b:02X}{a:02X}"

    sigcolor = np.full(len(out), None, dtype=object)

    for i in range(len(out)):
        ob = osc_bias.iloc[i]
        os_ = osc_smooth.iloc[i]

        if np.isnan(ob) or np.isnan(os_):
            sigcolor[i] = None
            continue

        if (ob > 0) and (ob >= os_):
            sigcolor[i] = color_new(col_bull, 35)
        elif (ob > 0) and (ob < os_):
            sigcolor[i] = color_new(col_bull, 75)
        elif (ob < 0) and (ob <= os_):
            sigcolor[i] = color_new(col_bear, 35)
        elif (ob < 0) and (ob > os_):
            sigcolor[i] = color_new(col_bear, 75)
        else:
            sigcolor[i] = None

    out["sigcolor"] = sigcolor

    # Candle color for smoothed HA candles (Pine: col = o2 > c2 ? col_bear : col_bull)
    candle_color = np.where(o2 > c2, col_bear, col_bull)
    out["candle_color"] = candle_color

    return out

# safe formatting
def format_price(value):
    """Safely format price as $XXX.XX or N/A"""
    if pd.isna(value) or value == 'N/A':
        return "N/A"
    try:
        return f"${float(value):.2f}"
    except (ValueError, TypeError):
        return str(value)

def format_delta(value):
    """Safely format delta as XX.X% or N/A"""
    if pd.isna(value) or value == 'N/A':
        return "N/A"
    try:
        return f"{float(value):.1f}%"
    except (ValueError, TypeError):
        return str(value)
    

