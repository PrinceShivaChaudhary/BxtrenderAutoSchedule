# ---------- Main processing function ----------
def process_stock_data(symbol, data_path):
    """Process single stock data and return processed DataFrame"""
    try:
        # Try to load from individual CSV first
        #data_path = DATA_PATH
        #symbol = "aapl"
        csv_file = f"{data_path}/{symbol.lower()}.csv"
        if os.path.exists(csv_file):
            df = pd.read_csv(csv_file)
        else:
            # Fallback: try original AAPL path format
            csv_file = f"C:/Users/prince/Downloads/{symbol.lower()}.csv"
            if os.path.exists(csv_file):
                df = pd.read_csv(csv_file)
            else:
                print(f"Warning: Could not find data for {symbol}")
                return None
        
        df["Date"] = pd.to_datetime(df["Date"])
        df = df.sort_values("Date").reset_index(drop=True)
        close = df["Close"]
        
        # Compute B-Xtrender
        short_term_raw = ema(close, short_l1) - ema(close, short_l2)
        short_term_xtrender = rsi(short_term_raw, short_l3) - 50
        df["shortTermXtrender"] = short_term_xtrender
        df["maShortTermXtrender"] = t3(short_term_xtrender, 5)
        
        # Trading signals
        bx = df["shortTermXtrender"]
        bx_prev = bx.shift(1)
        is_upward_momentum = bx > bx_prev
        is_strong_downward = bx < bx_prev
        is_positive_value = bx > 0
        is_negative_value = bx < 0
        
        df['Signal'] = 0
        #df.loc[(is_upward_momentum & is_positive_value), 'Signal'] = 1
        #df.loc[(is_strong_downward & is_positive_value), 'Signal'] = -1
        #new
        df.loc[(is_upward_momentum & is_positive_value), 'Signal'] = 1 #HH
        df.loc[(is_strong_downward & is_positive_value), 'Signal'] = 1 #LH
        df.loc[(is_upward_momentum & is_negative_value), 'Signal'] = 1 #HL for negative numbers symbols flip as -2 is > -3
        df.loc[(is_strong_downward & is_negative_value), 'Signal'] = -1 #LL
        
        
        
        
        # Colors for histogram
        is_up = bx > 0.0
        is_down = bx < 0.0
        is_rising = bx > bx_prev
        is_falling = bx < bx_prev
        
        colors = np.where(
            is_up & is_rising, "#00ff00",
            np.where(is_up & is_falling, "#009900",
                np.where(is_down & is_falling, "#ff0000",
                    np.where(is_down & is_rising, "#990000", "#aaaaaa")
                )
            )
        )
        df["colors"] = colors
        df["idx"] = range(len(df))
        df['Symbol'] = symbol
        
        return df
        
    except Exception as e:
        print(f"Error processing {symbol}: {e}")
        return None

def download_google_sheet(spreadsheet_id, timeframe, output_dir="C:/Users/prince/Downloads/bxtrender/Data"):
