def delete_csv_files_in_folders(DATA_PATH_WEEKLY, DATA_PATH_DAILY, DATA_PATH_MONTHLY, DATA_PATH_15DAY):
    """Delete ALL CSV files in Weekly, Daily, and Monthly folders"""
    
    folders = [DATA_PATH_WEEKLY, DATA_PATH_DAILY, DATA_PATH_MONTHLY]
    
    total_deleted = 0
    
    for folder_path in folders:
        folder = Path(folder_path)
        
        if not folder.exists():
            print(f" Folder not found: {folder}")
            continue
            
        # Get all CSV files
        csv_files = list(folder.glob("*.csv"))
        
        print(f" {folder.name}: Found {len(csv_files)} CSV files")
        
        for csv_file in csv_files:
            try:
                csv_file.unlink()  # Delete file
                print(f"  Deleted: {csv_file.name}")
                total_deleted += 1
            except Exception as e:
                print(f"   Error deleting {csv_file.name}: {e}")
        
        print(f" {folder.name}: Cleared {len(csv_files)} files\n")
    
    print(f" TOTAL: {total_deleted} CSV files deleted across all folders!")





