def close_bias(df: pd.DataFrame,len1: int = 33,len2: int = 8,band_mult: float = 8) -> pd.DataFrame:
    """
    Close-only market bias (no oscillator).

    Inputs:
        df      : must have column 'Close'
        len1    : first EMA length on close
        len2    : second EMA length on smoothed close
        band_mult : width of band in units of ATR of the smoothed series (approx)

    Outputs (added columns):
        c1      : first EMA of Close
        c2      : second EMA of c1  (bias core)
        upper   : upper bias band
        lower   : lower bias band
        bias    : same as c2 (midline)
        bias_color : 'bull' or 'bear' based on slope of bias
    """

    out = df.copy()

    # 1) First smoothing
    c1 = out["Close"].ewm(span=len1, adjust=False).mean()

    # 2) Second smoothing (core bias line)
    c2 = c1.ewm(span=len2, adjust=False).mean()

    # 3) Band around bias: use EMA of abs dev from c2
    abs_dev = (c1 - c2).abs()
    dev_ema = abs_dev.ewm(span=len2, adjust=False).mean()

    upper = c2 + band_mult * dev_ema
    lower = c2 - band_mult * dev_ema

    # 4) Bias direction from slope of c2
    slope = c2.diff()
    bias_color = np.where(slope > 0, "bull", "bear")

    out["c1"] = c1
    out["c2"] = c2
    out["bias"] = c2
    out["upper"] = upper
    out["lower"] = lower
    out["bias_color"] = bias_color

    return out

def close_bias_by_symbol(df: pd.DataFrame,
                         len1: int = 50,
                         len2: int = 50,
                         band_mult: float = 1.5) -> pd.DataFrame:
    """
    Apply close_bias separately for each Symbol in a multi‑ticker DataFrame.
    close_bias itself is unchanged; we just apply it group‑by‑group.
    """
    def _apply_bias(group: pd.DataFrame) -> pd.DataFrame:
        # run your existing function on this ticker only
        biased = close_bias(group, len1=len1, len2=len2, band_mult=band_mult)
        return biased

    # group by Symbol and apply, then stitch back together
    out = (
        df.sort_values(["Symbol", "Date"])     # keep order clean if you have Date
          .groupby("Symbol", group_keys=False)
          .apply(_apply_bias)
    )
    return out


